<Project>
  <!--
    ONNX Runtime's DirectML package pulls DirectML.dll only when referenced directly.
    Transitive ProjectReferences drop it, and the system copy on Win10 is too old
    (1.2MB, 2021) -> DML device creation fails with DXGI_ERROR_UNSUPPORTED.
  -->
  <ItemGroup>
    <_DirectMlNative Include="$(NuGetPackageRoot)microsoft.ai.directml/*/bin/x64-win/DirectML.dll" />
  </ItemGroup>

  <Target Name="CopyDirectMlNative" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' != ''">
    <Copy SourceFiles="@(_DirectMlNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyDirectMlNativeToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Copy SourceFiles="@(_DirectMlNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Self-contained .NET does not carry the VC++ runtime. Unpackaged WinUI / ORT
    still need it, and stock Win10 does not ship it, so deploy app-local.
  -->
  <ItemGroup>
    <_VcRuntimeNative Include="$(SystemRoot)\System32\vcruntime140.dll" />
    <_VcRuntimeNative Include="$(SystemRoot)\System32\vcruntime140_1.dll" />
    <_VcRuntimeNative Include="$(SystemRoot)\System32\msvcp140.dll" />
    <_VcRuntimeNative Include="$(SystemRoot)\System32\msvcp140_1.dll" />
    <_VcRuntimeNative Include="$(SystemRoot)\System32\msvcp140_2.dll" />
    <_VcRuntimeNative Include="$(SystemRoot)\System32\concrt140.dll" />
    <_VcRuntimeNative Include="$(SystemRoot)\System32\vccorlib140.dll" />
  </ItemGroup>

  <Target Name="CopyVcRuntimeToPublish" AfterTargets="Publish"
          Condition="'$(PublishDir)' != '' and Exists('$(SystemRoot)\System32\vcruntime140.dll')">
    <Copy SourceFiles="@(_VcRuntimeNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    WinUI 3 leaves the compiled XAML (.xbf) and the app PRI out of the publish
    folder; without them every Window but the first fails at InitializeComponent.
  -->
  <Target Name="CopyWinUiXamlResourcesToPublish" AfterTargets="Publish"
          Condition="'$(UseWinUI)' == 'true' and '$(PublishDir)' != ''">
    <ItemGroup>
      <_WinUiXaml Include="$(OutDir)*.xbf" />
      <_WinUiXaml Include="$(OutDir)$(AssemblyName).pri" Condition="Exists('$(OutDir)$(AssemblyName).pri')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUiXaml)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
