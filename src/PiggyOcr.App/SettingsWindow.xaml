<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PiggyOcr.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel Padding="24" Spacing="18">
            <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" />

            <StackPanel Spacing="8">
                <TextBlock Text="快捷键" FontSize="15" FontWeight="SemiBold" />
                <TextBox x:Name="HotkeyBox" IsReadOnly="True"
                         GotFocus="OnHotkeyFocus" LostFocus="OnHotkeyLostFocus"
                         KeyDown="OnHotkeyKeyDown" />
                <TextBlock x:Name="HotkeyHint" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                           Text="点击后按下组合键。至少一个修饰键（Ctrl / Alt / Shift / Win），或使用 F1–F24。" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="鼠标动作" FontSize="15" FontWeight="SemiBold" />
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="左键拖选" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LeftCombo" SelectionChanged="OnMouseActionChanged">
                        <ComboBoxItem Content="识别并编辑" />
                        <ComboBoxItem Content="识别并复制后关闭" />
                        <ComboBoxItem Content="全屏识别" />
                        <ComboBoxItem Content="取消" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="中键拖选" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="MiddleCombo" SelectionChanged="OnMouseActionChanged">
                        <ComboBoxItem Content="识别并编辑" />
                        <ComboBoxItem Content="识别并复制后关闭" />
                        <ComboBoxItem Content="全屏识别" />
                        <ComboBoxItem Content="取消" />
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="右键" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="RightCombo" SelectionChanged="OnMouseActionChanged">
                        <ComboBoxItem Content="识别并编辑" />
                        <ComboBoxItem Content="识别并复制后关闭" />
                        <ComboBoxItem Content="全屏识别" />
                        <ComboBoxItem Content="取消" />
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="双击" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="DoubleCombo" SelectionChanged="OnMouseActionChanged">
                        <ComboBoxItem Content="识别并编辑" />
                        <ComboBoxItem Content="识别并复制后关闭" />
                        <ComboBoxItem Content="全屏识别" />
                        <ComboBoxItem Content="取消" />
                    </ComboBox>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="识别" FontSize="15" FontWeight="SemiBold" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="模型档位" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="TierCombo" SelectionChanged="OnTierChanged">
                        <ComboBoxItem Content="自动（已安装的最高档）" />
                        <ComboBoxItem Content="tiny" />
                        <ComboBoxItem Content="small" />
                        <ComboBoxItem Content="medium" />
                    </ComboBox>
                </Grid>
                <TextBlock x:Name="TierHint" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                <TextBlock x:Name="BackendText" FontSize="12" Opacity="0.6" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="结果窗" FontSize="15" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="AutoCopySwitch" Header="识别后自动复制到剪贴板" Toggled="OnAutoCopyToggled" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="通用" FontSize="15" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="AutoStartSwitch" Header="开机自启" Toggled="OnAutoStartToggled" />
                <ToggleSwitch x:Name="CheckUpdateSwitch" Header="检查更新（每周一次）" Toggled="OnCheckUpdateToggled" />
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                    <Button Content="检查更新" Click="OnCheckUpdate" />
                    <Button Content="打开模型目录" Click="OnOpenModels" />
                    <TextBlock x:Name="VersionText" VerticalAlignment="Center" FontSize="12" Opacity="0.6" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
