<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PiggyOcr.App.ResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Padding="14" RowSpacing="10"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="识别结果" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="CopyButton" Content="复制" HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}" Click="OnCopyClick" />
        </Grid>

        <TextBox x:Name="Text" Grid.Row="1"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 IsSpellCheckEnabled="False"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 TextChanged="OnTextChanged" />

        <Grid Grid.Row="2">
            <TextBlock x:Name="Count" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <CheckBox x:Name="JoinLines" Content="合并为一段" Click="OnJoinClick" />
                <Button Content="关闭" Click="OnCloseClick" />
            </StackPanel>
        </Grid>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnCopyClose" />
        </Grid.KeyboardAccelerators>
    </Grid>
</Window>
